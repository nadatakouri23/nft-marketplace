# Copie ce fichier en frontend/.env. NE COMMITE JAMAIS .env
# JWT Pinata (app.pinata.cloud > API Keys). Sans préfixe VITE_ : reste côté serveur Vite.
# Redémarre `npm run dev` après modification.
PINATA_JWT=
# Optionnel : passerelle IPFS de lecture (ex. ta passerelle dédiée Pinata : https://xxxx.mypinata.cloud/ipfs/)
VITE_IPFS_GATEWAY=
